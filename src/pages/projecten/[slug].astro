---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import { projects, type Project } from '../../data/projects';
import { route } from '../../utils/asset';
import { getImg } from '../../utils/images';
import { ogPad, schemaId } from '../../data/seo';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
};

interface Props {
  project: Project;
}

const { project } = Astro.props;
const idx = projects.findIndex(p => p.slug === project.slug);
const prev = idx > 0 ? projects[idx - 1] : null;
const next = idx < projects.length - 1 ? projects[idx + 1] : null;

const coverImg = await getImg(project.cover);

const galleryData = await Promise.all(
  project.images.map(async (path) => {
    const img = await getImg(path);
    const full = await getImage({ src: img, format: 'webp', quality: 85, width: 1600 });
    return { meta: img, url: full.src };
  })
);
const imagesJson = JSON.stringify(galleryData.map((d, i) => ({
  url: d.url,
  credit: project.imageCredits?.[i] ?? null,
})));
---

<BaseLayout
  title={`${project.title} · ${project.location} — KA.architecten`}
  description={project.metaDescription ?? project.intro}
  ogImage={project.cover}
  ogImageAlt={`${project.title}, ${project.location}`}
  canonical={`https://www.ka-architecten.nl/projecten/${project.slug}/`}
  kruimels={[
    { naam: 'Projecten', pad: '/projecten/' },
    { naam: project.title, pad: `/projecten/${project.slug}/` },
  ]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": project.title,
    "description": project.intro,
    "url": `https://www.ka-architecten.nl/projecten/${project.slug}/`,
    "image": new URL(ogPad(project.cover), Astro.site).toString(),
    "creator": { "@id": new URL(schemaId.persoon, Astro.site).toString() },
    "publisher": { "@id": new URL(schemaId.bedrijf, Astro.site).toString() },
    "locationCreated": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": project.location,
        "addressRegion": project.province,
        "addressCountry": "NL"
      }
    },
    "dateCreated": project.year,
  })} />

  <article>
    <!-- HERO: coverfoto full-bleed met titel overlay -->
    <section class="project-hero">
      <Image
        src={coverImg}
        alt={`${project.title}, ${project.location}`}
        fetchpriority="high"
        width={1920}
        format="webp"
        quality={85}
      />
      <div class="project-hero-veil"></div>
      <a href={route('/projecten')} class="project-back"><span class="arrow">←</span>Projecten</a>
      <div class="project-hero-content">
        <p class="eyebrow" style="color: rgba(246,245,241,0.65);">{project.location}</p>
        <h1 style="color: #F6F5F1; margin-top: 10px; max-width: 22ch;">{project.title}</h1>
      </div>
    </section>

    <!-- INTRO + BODY + FACTS -->
    <section class="section" style="padding-top: 48px; padding-bottom: 40px;">
      <div class="container">
        <p class="lead" style="margin-bottom: clamp(32px, 4vw, 56px); max-width: 60ch;">{project.intro}</p>
        <div class="detail-grid">
          <div class="body-text" style="font-size: 17px;">
            {project.body.map(p => <p>{p}</p>)}
          </div>
          <div class="facts">
            <dl>
              <dt>Locatie</dt><dd>{project.location}, {project.province}</dd>
              <dt>Type</dt><dd>{project.type}</dd>
              <dt>Status</dt><dd>{project.status} · {project.year}</dd>
              <dt>Architect</dt><dd>{project.architect}</dd>
              {project.opdrachtgever && <><dt>Opdrachtgever</dt><dd>{project.opdrachtgever}</dd></>}
              {project.interieurarchitect && <><dt>Interieur</dt><dd>{project.interieurarchitect}</dd></>}
              {project.aannemer && <><dt>Aannemer</dt><dd>{project.aannemer}</dd></>}
              {project.constructeur && <><dt>Constructeur</dt><dd>{project.constructeur}</dd></>}
              {project.fotograaf && <><dt>Fotografie</dt><dd>{project.fotograaf}</dd></>}
              {project.erkenning && <><dt>Erkenning</dt><dd>{project.erkenning}</dd></>}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- GALERIJ -->
    {project.images.length > 1 && (
      <section class="section hairline" style="padding-top: 40px;">
        <div class="container">
          <p class="eyebrow mb-md">
            Beelden
          </p>
          <div
            class="gallery"
            data-lightbox-group={imagesJson}
            data-lightbox-caption={project.title}
          >
            {galleryData.map((d, i) => {
              const cls = i === 0 ? 'g-wide' : 'g-half';
              const credit = project.imageCredits?.[i] ?? null;
              return (
                <figure class={cls}>
                  <Image
                    src={d.meta}
                    alt={`${project.title} (${i + 1}/${project.images.length})`}
                    loading="lazy"
                    width={i === 0 ? 1400 : 900}
                    format="webp"
                    quality={85}
                  />
                  {credit && <figcaption class="img-credit">© {credit}</figcaption>}
                </figure>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </article>

  <!-- PAGER -->
  <section class="section hairline">
    <div class="container">
      <div class="pager">
        {prev ? (
          <a href={route(`/projecten/${prev.slug}`)}>
            <span class="label">← Vorig project</span>
            <span class="title">{prev.title}</span>
          </a>
        ) : <div />}
        {next ? (
          <a class="next" href={route(`/projecten/${next.slug}`)}>
            <span class="label">Volgend project →</span>
            <span class="title">{next.title}</span>
          </a>
        ) : <div />}
      </div>
      <p style="margin-top: 40px;">
        <a class="link-arrow" href={route('/contact')}>Plan een vrijblijvend gesprek →</a>
      </p>
    </div>
  </section>
</BaseLayout>
