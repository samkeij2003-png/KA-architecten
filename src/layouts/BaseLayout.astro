---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import { pub } from '../utils/asset';
import { ogPad, standaardDeelbeeld, type Kruimel } from '../data/seo';

interface Props {
  title: string;
  description?: string;
  /** Foto in public/ voor het deelbeeld; moet in `deelbeelden` (src/data/seo.ts) staan. */
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  noIndex?: boolean;
  bodyClass?: string;
  /** Kruimelpad na Home, voor de structured data. */
  kruimels?: Kruimel[];
}

const {
  title,
  description = 'KA.architecten ontwerpt particuliere woningen, verbouwingen en utiliteitsbouw vanuit Tilburg, voor heel Noord-Brabant.',
  ogImage = standaardDeelbeeld,
  ogImageAlt = 'Betonnen woonhuis in Zeist, ontworpen door KA.architecten',
  canonical,
  noIndex = false,
  bodyClass = '',
  kruimels,
} = Astro.props;

const ogImageUrl = new URL(ogPad(ogImage), Astro.site).toString();

// Altijd met trailing slash: dat is de URL die GitHub Pages zonder redirect serveert.
const canonicalRaw = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const canonicalUrl = canonicalRaw.endsWith('/') ? canonicalRaw : `${canonicalRaw}/`;
const gaId = import.meta.env.PUBLIC_GA_ID ?? '';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="KA.architecten" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Schema kruimels={kruimels} />

    <meta name="author" content="Peter Keijsers" />
    <meta name="geo.region" content="NL-NB" />
    <meta name="geo.placename" content="Tilburg, Noord-Brabant" />
    <meta name="geo.position" content="51.5556;5.0913" />
    <meta name="ICBM" content="51.5556, 5.0913" />

    <!-- Google toont in zoekresultaten een favicon van minimaal 48x48 (veelvoud van 48) -->
    <link rel="icon" href={pub('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={pub('/favicon-48x48.png')} type="image/png" sizes="48x48" />
    <link rel="icon" href={pub('/favicon-96x96.png')} type="image/png" sizes="96x96" />
    <link rel="icon" href={pub('/favicon-192x192.png')} type="image/png" sizes="192x192" />
    <link rel="icon" href={pub('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={pub('/apple-touch-icon.png')} sizes="180x180" />
    <meta name="theme-color" content="#f5f3ef" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet" />

    <ViewTransitions />
    <slot name="head" />

    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} is:inline></script>}
    {gaId && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${gaId}');`}></script>}
  </head>
  <body class={bodyClass}>
    <Header />
    <slot />
    <Footer />

    <script src={pub('/js/site.js')} is:inline></script>
  </body>
</html>
