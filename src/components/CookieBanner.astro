---
import { route } from '../utils/asset';
---

<section class="cookie-banner" data-cookie-banner aria-labelledby="cookie-title" hidden>
  <div class="cookie-inner">
    <div>
      <h2 id="cookie-title">Cookies voor statistiek</h2>
      <p>
        Mogen wij met Google Analytics meten hoe deze website wordt gebruikt? Zo zien we welke
        pagina's goed werken. We gebruiken dit niet voor advertenties. Meer in de
        <a href={route('/algemene-voorwaarden')} class="text-link">privacyverklaring</a>.
      </p>
    </div>
    <div class="cookie-actions">
      <button type="button" class="btn" data-cookie-accept>Accepteren</button>
      <button type="button" class="btn" data-cookie-refuse>Weigeren</button>
    </div>
  </div>
</section>

<style>
  .cookie-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 100;
    background: var(--bg);
    border-top: 1px solid var(--hairline);
    box-shadow: 0 -8px 24px rgb(31 30 27 / 0.08);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 20px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    align-items: center;
    justify-content: space-between;
  }
  h2 {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 6px;
  }
  p {
    margin: 0;
    max-width: var(--measure-wide);
    font-size: 14px;
    color: var(--ink-soft);
  }
  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cookie-actions .btn {
    min-height: 44px;
  }
  .btn:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
