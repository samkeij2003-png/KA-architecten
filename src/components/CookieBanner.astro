---
/**
 * Cookiebanner voor Google Analytics 4. Het script van Google laadt pas na Accepteren
 * (geen Zaraz: de site draait op GitHub Pages, niet via Cloudflare). Daarvoor gaat er niets naar Google.
 * Weigeren en Accepteren zijn even groot en staan naast elkaar (eis Autoriteit Persoonsgegevens).
 * "Cookie-instellingen" in de footer (href #cookie-instellingen) opent hem opnieuw; Weigeren na
 * eerder Accepteren zet de meting uit en wist de _ga-cookies.
 */
import { route } from '../utils/asset';

interface Props {
  gaId: string;
}

const { gaId } = Astro.props;
---

<section
  class="cbanner"
  aria-labelledby="cbanner-kop"
  data-cookiebanner
  data-ga-id={gaId}
  transition:persist="cookiebanner"
  hidden
>
  <p class="cbanner__label">Cookies</p>
  <h2 id="cbanner-kop" class="cbanner__kop">Mogen wij meten hoe de site gebruikt wordt?</h2>
  <p class="cbanner__tekst">
    Met uw toestemming gebruikt KA Architecten Google Analytics. Dat plaatst cookies en verzamelt gegevens over uw bezoek, zoals welke pagina's u bekijkt en hoe u op de site kwam. Zo zien wij wat bezoekers zoeken en kunnen wij de site verbeteren. Deze gegevens gaan naar één andere partij: Google. Zonder uw toestemming plaatsen wij geen cookies en verzamelen wij niets.
    U kunt uw keuze altijd wijzigen via <a class="text-link" href="#cookie-instellingen">Cookie-instellingen</a> onderaan de pagina. Meer leest u in de <a class="text-link" href={`${route('/algemene-voorwaarden')}#cookies`}>privacyverklaring</a>.
  </p>
  <div class="cbanner__knoppen">
    <button type="button" class="btn ghost" data-cookie-keuze="nee">Weigeren</button>
    <button type="button" class="btn" data-cookie-keuze="ja">Accepteren</button>
  </div>
</section>

<style>
  .cbanner {
    position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 150;
    background: var(--bg); color: var(--ink);
    border: 1px solid var(--hairline); border-top: 2px solid var(--ink);
    box-shadow: 0 12px 40px rgba(31, 30, 27, 0.12);
    padding: 22px 20px 18px;
  }
  .cbanner[hidden] { display: none; }
  .cbanner__label { font-family: var(--font-display); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--stone); }
  .cbanner__kop { margin-top: 10px; font-family: var(--font-display); font-size: 20px; font-weight: 400; line-height: 1.2; }
  .cbanner__tekst { margin-top: 10px; font-size: 13px; line-height: 1.7; color: var(--ink-soft); }
  .cbanner__knoppen { margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cbanner__knoppen .btn { width: 100%; padding-left: 12px; padding-right: 12px; text-align: center; }
  @media (min-width: 640px) {
    .cbanner { left: 24px; right: auto; bottom: 24px; width: 400px; padding: 26px 26px 22px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cbanner:not([hidden]) { animation: cbanner-in .35s ease-out; }
  }
  @keyframes cbanner-in { from { opacity: 0; transform: translateY(12px); } }
</style>

<script>
  type Gtag = (...args: unknown[]) => void;
  type Venster = Window & { dataLayer?: unknown[]; gtag?: Gtag } & Record<string, unknown>;

  const SLEUTEL = 'ka-cookies';
  const w = window as unknown as Venster;
  const banner = () => document.querySelector<HTMLElement>('[data-cookiebanner]');
  const gaId = banner()?.dataset.gaId ?? '';

  const bewaard = (): string | null => {
    try { return localStorage.getItem(SLEUTEL); } catch { return null; }
  };

  // Consent Mode: alles staat standaard uit, alleen statistieken gaan aan na Accepteren.
  w.dataLayer = w.dataLayer || [];
  const gtag: Gtag = function () { w.dataLayer!.push(arguments); };

  let geladen = false;
  const laadAnalytics = () => {
    w[`ga-disable-${gaId}`] = false;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    if (geladen) return;
    geladen = true;
    w.gtag = gtag;
    gtag('js', new Date());
    gtag('config', gaId);
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
    document.head.appendChild(s);
  };

  const stopAnalytics = () => {
    if (!geladen) return;
    w[`ga-disable-${gaId}`] = true;
    gtag('consent', 'update', { analytics_storage: 'denied' });
    const domein = location.hostname.replace(/^www\./, '');
    document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((n) => n.startsWith('_ga')).forEach((n) => {
      for (const d of ['', `; domain=${domein}`, `; domain=.${domein}`]) {
        document.cookie = `${n}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${d}`;
      }
    });
  };

  const kies = (ja: boolean) => {
    if (ja) laadAnalytics();
    else stopAnalytics();
    try { localStorage.setItem(SLEUTEL, ja ? 'ja' : 'nee'); } catch { /* geen opslag: dan vraagt de banner het opnieuw */ }
    const b = banner();
    if (b) b.hidden = true;
  };

  if (gaId) {
    gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    const keuze = bewaard();
    if (keuze === 'ja') laadAnalytics();
    else if (!keuze) { const b = banner(); if (b) b.hidden = false; }

    document.addEventListener('click', (e) => {
      const doel = e.target as Element | null;
      const knop = doel?.closest<HTMLElement>('[data-cookie-keuze]');
      if (knop) { kies(knop.dataset.cookieKeuze === 'ja'); return; }
      if (!doel?.closest('a[href="#cookie-instellingen"]')) return;
      e.preventDefault();
      const b = banner();
      if (!b) return;
      b.hidden = false;
      b.querySelector<HTMLElement>('[data-cookie-keuze="nee"]')?.focus();
    });
  }
</script>
