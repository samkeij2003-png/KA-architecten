---
/** Fotogalerij van een project: eerste foto breed, de rest in twee kolommen, met lightbox (public/js/site.js). */
import { getImage } from 'astro:assets';
import CmsImage from '../cms/CmsImage.astro';
import { items, text } from '../../lib/mijn-sasa/client';
import { isPreview, sasaField, sasaSection } from '../../lib/site-content';
import type { SectionProps } from './types';

type Props = SectionProps;
const { section, cms, page } = Astro.props;

const photos = items(section.data.images)
  .map((item) => ({ item, media: cms.media(item.image) }))
  .filter((p) => p.media);

// Grote versie voor de lightbox: bij de build een webp van 1600 breed, in het voorbeeld het origineel.
const large = await Promise.all(
  photos.map(async ({ media }) => {
    if (isPreview || !media!.width || !media!.height) return media!.url;
    const img = await getImage({
      src: media!.url,
      width: 1600,
      height: Math.round((1600 * media!.height) / media!.width),
      format: 'webp',
      quality: 85,
    });
    return img.src;
  }),
);
const imagesJson = JSON.stringify(photos.map(({ item }, i) => ({ url: large[i], credit: text(item.credit) || null })));
---

{photos.length > 1 && (
  <section class="section hairline" style="padding-top: 40px;" {...sasaSection(section.id)}>
    <div class="container">
      <p class="eyebrow mb-md">Beelden</p>
      <div class="gallery" data-lightbox-group={imagesJson} data-lightbox-caption={page.title}>
        {photos.map(({ item, media }, i) => (
          <figure class={i === 0 ? 'g-wide' : 'g-half'}>
            <CmsImage
              media={media}
              alt={media!.alt || `${page.title} (${i + 1}/${photos.length})`}
              width={i === 0 ? 1400 : 900}
              loading="lazy"
              field={sasaField(section.id, `images.${item.id}.image`, 'image')}
            />
            {text(item.credit) && <figcaption class="img-credit">© {text(item.credit)}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
