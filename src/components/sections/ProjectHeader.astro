---
import CmsImage from '../cms/CmsImage.astro';
import { projectInfo } from '../../lib/ka';
import { route, sasaField, sasaSection } from '../../lib/site-content';
import type { SectionProps } from './types';

type Props = SectionProps;
const { section, cms, page } = Astro.props;
const project = projectInfo(cms, page);
const overview = cms.pages.find((p) => p.sections.some((s) => s.type === 'projectGrid' && s.data.limit === 'all'));
---

<section class="project-hero" {...sasaSection(section.id)}>
  <CmsImage media={project.cover} alt={`${project.title}, ${project.location}`} width={1920} fetchpriority="high" field={sasaField(section.id, 'cover', 'image')} />
  <div class="project-hero-veil"></div>
  <a href={route(overview?.path ?? '/projecten')} class="project-back"><span class="arrow">←</span>{overview?.title ?? 'Projecten'}</a>
  <div class="project-hero-content">
    <p class="eyebrow" style="color: rgba(246,245,241,0.65);">{project.location}</p>
    <h1 style="color: #F6F5F1; margin-top: 10px; max-width: 22ch;">{project.title}</h1>
  </div>
</section>
