---
import CmsImage from '../cms/CmsImage.astro';
import { route, sasaField, sasaSection } from '../../lib/site-content';
import type { SectionProps } from './types';

type Props = SectionProps;
const { section, cms } = Astro.props;
const d = section.data;
const target = cms.pageById(typeof d.pageId === 'string' ? d.pageId : null);
const media = cms.media(d.image);
const box = 'display: block; background: var(--bg-soft); overflow: hidden; aspect-ratio: 16/6; max-height: 480px;';
const imgStyle = 'width: 100%; height: 100%; object-fit: cover; object-position: center;';
const label = target ? `Bekijk ${target.template === 'project' ? 'project' : 'pagina'}: ${target.title}` : undefined;
---

<div class="container" {...sasaSection(section.id)}>
  {target ? (
    <a href={route(target.path)} class="bureau-img-link" style={box} aria-label={label}>
      <CmsImage media={media} width={1600} loading="lazy" style={imgStyle} field={sasaField(section.id, 'image', 'image')} />
    </a>
  ) : (
    <div class="bureau-img-link" style={box}>
      <CmsImage media={media} width={1600} loading="lazy" style={imgStyle} field={sasaField(section.id, 'image', 'image')} />
    </div>
  )}
</div>

<style>
  .bureau-img-link :global(img) {
    transition: transform 0.4s ease;
  }
  .bureau-img-link:hover :global(img) {
    transform: scale(1.03);
  }
</style>
