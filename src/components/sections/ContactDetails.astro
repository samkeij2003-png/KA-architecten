---
/**
 * Contactgegevens (uit Bedrijfsgegevens in Mijn SASA) met het contactformulier.
 * Het formulier zelf ligt vast in de code (Web3Forms); alleen de onderwerpen
 * komen uit Mijn SASA. De paginakop (label en titel) staat links in de kolom.
 */
import { items, text } from '../../lib/mijn-sasa/client';
import { phoneE164 } from '../../lib/ka';
import { route, sasaField, sasaSection } from '../../lib/site-content';
import type { SectionProps } from './types';

type Props = SectionProps;
const { section, cms, page } = Astro.props;
const header = page.sections.find((s) => s.type === 'pageHeader');
const address = cms.settings('address');
const contact = cms.settings('contact');
const company = cms.settings('company');
const EMAIL = text(contact.email);
const phone = text(contact.phone);
const subjects = items(section.data.subjects).map((s) => text(s.label)).filter(Boolean);
const privacy = cms.pagesByTemplate('legal')[0];
// Berichten lopen via Web3Forms; de ontvanger staat ingesteld in het
// Web3Forms-account. De access key is bedoeld om publiek in de pagina te staan.
const FORM_ENDPOINT = 'https://api.web3forms.com/submit';
const WEB3FORMS_KEY = 'ac85915f-ff2e-4452-94b7-b52fca9734b5';
---

  <section class="section" style="padding-top: clamp(28px, 3vw, 44px); padding-bottom: clamp(40px, 6vw, 80px);" {...sasaSection(section.id)}>
    <div class="container">
      <div class="contact-grid">
        <!-- Linker kolom: titel + gegevens -->
        <div class="contact-info">
          <p class="eyebrow" {...(header ? sasaField(header.id, 'eyebrow') : {})}>{text(header?.data.eyebrow)}</p>
          <h1 style="margin-top: 8px; margin-bottom: 32px;" {...(header ? sasaField(header.id, 'title') : {})}>{text(header?.data.title)}</h1>

          <p class="eyebrow" style="margin-bottom: 8px;">Adres</p>
          <p style="font-size: 16px; line-height: 1.8; color: var(--ink-soft);">
            {text(company.name)}<br />
            {text(address.street)}<br />
            {text(address.postcode)} {text(address.city)}
          </p>

          <p class="eyebrow" style="margin: 28px 0 8px;">Telefoon</p>
          <p><a href={`tel:${phoneE164(phone)}`} style="font-size: 16px; color: var(--ink-soft);">{phone}</a></p>

          <p class="eyebrow" style="margin: 28px 0 8px;">E-mail</p>
          <p><a href={`mailto:${EMAIL}`} style="font-size: 16px; color: var(--ink-soft);">{EMAIL}</a></p>
        </div>

        <!-- Rechter kolom: formulier -->
        <div class="contact-form-wrap">
          <form
            id="contact-form"
            action={FORM_ENDPOINT}
            method="POST"
            data-fallback-email={EMAIL}
            novalidate
          >
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="from_name" value="Website KA.architecten" />
            <!-- Honeypot: onzichtbaar voor bezoekers, bots vinken het aan -->
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="form-grid">
              <div class="form-row">
                <label for="naam">Naam *</label>
                <input id="naam" name="naam" type="text" required autocomplete="name" placeholder="Uw naam" />
                <p class="field-error">Vul uw naam in.</p>
              </div>
              <div class="form-row">
                <label for="telefoon">Telefoon</label>
                <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" placeholder="Optioneel" />
              </div>
            </div>
            <div class="form-row">
              <label for="email">E-mail *</label>
              <input id="email" name="email" type="email" required autocomplete="email" placeholder="Uw e-mailadres" />
              <p class="field-error">Vul een geldig e-mailadres in.</p>
            </div>
            <div class="form-row">
              <label for="onderwerp">Onderwerp</label>
              <select id="onderwerp" name="onderwerp">
                {subjects.map((label) => <option>{label}</option>)}
              </select>
            </div>
            <div class="form-row">
              <label for="bericht">Bericht *</label>
              <textarea id="bericht" name="bericht" rows="5" required minlength="10" placeholder="Vertel kort over uw plek en wensen"></textarea>
              <p class="field-error">Schrijf een kort bericht (minimaal 10 tekens).</p>
            </div>

            <p class="privacy-note">
              Uw gegevens gebruiken we alleen om op uw bericht te reageren. Lees meer in onze
              <a href={privacy ? route(privacy.path) : '/algemene-voorwaarden/'} class="text-link">privacyverklaring</a>.
            </p>

            <div class="form-actions">
              <button type="submit" class="btn" id="contact-submit">Verzenden</button>
              <p class="form-note">We reageren doorgaans binnen twee werkdagen.</p>
            </div>

            <div class="form-status" role="status" aria-live="polite" hidden></div>
          </form>
        </div>
      </div>
    </div>
  </section>


<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.8fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .contact-form-wrap {
    border: 1px solid var(--hairline);
    padding: clamp(24px, 3vw, 40px);
    background: var(--bg);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
  }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  /* Absoluut gepositioneerd in de marge onder het veld, zodat er geen
     layout-verschuiving is (die zou een klik op Verzenden laten missen) */
  .form-row { position: relative; }
  .field-error {
    display: none;
    position: absolute;
    top: 100%;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.4;
    color: #9B3B2E;
  }
  .is-invalid ~ .field-error { display: block; }
  .form-row .is-invalid { border-bottom-color: #9B3B2E; }

  .privacy-note {
    margin: 8px 0 4px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--stone);
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    align-items: center;
    margin-top: 24px;
  }
  .form-note { font-size: 13px; color: var(--stone); }

  .btn[disabled] { opacity: 0.6; cursor: progress; }

  .form-status {
    margin-top: 24px;
    padding: 16px 20px;
    border-left: 2px solid var(--ink);
    background: var(--bg-soft);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .form-status.is-error { border-left-color: #9B3B2E; }

  @media (max-width: 720px) {
    .contact-grid { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  type Field = HTMLInputElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>('#contact-form');

  if (form) {
    const submit = form.querySelector<HTMLButtonElement>('#contact-submit');
    const status = form.querySelector<HTMLDivElement>('.form-status');
    const fallbackEmail = form.dataset.fallbackEmail ?? '';
    const fields = Array.from(form.querySelectorAll<Field>('input[required], textarea[required]'));

    const value = (name: string): string =>
      (form.elements.namedItem(name) as HTMLInputElement | null)?.value.trim() ?? '';

    const markField = (field: Field): boolean => {
      const blank = field.type !== 'checkbox' && field.value.trim() === '';
      const ok = !blank && field.checkValidity();
      field.classList.toggle('is-invalid', !ok);
      field.setAttribute('aria-invalid', String(!ok));
      return ok;
    };

    // Pas na de eerste blur valideren, daarna live bij elke wijziging
    fields.forEach((field) => {
      field.addEventListener('blur', () => markField(field));
      ['input', 'change'].forEach((type) =>
        field.addEventListener(type, () => {
          if (field.classList.contains('is-invalid')) markField(field);
        }),
      );
    });

    const showStatus = (html: string, isError: boolean): void => {
      if (!status) return;
      status.innerHTML = html;
      status.classList.toggle('is-error', isError);
      status.hidden = false;
    };

    const setLoading = (loading: boolean): void => {
      if (!submit) return;
      submit.disabled = loading;
      submit.textContent = loading ? 'Bezig met verzenden…' : 'Verzenden';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (status) status.hidden = true;

      const firstInvalid = fields.map((field) => (markField(field) ? null : field)).find(Boolean);
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const data = new FormData(form);
      data.set('subject', `Website: ${value('onderwerp')} — ${value('naam')}`);
      data.set('replyto', value('email'));

      setLoading(true);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const result = (await response.json()) as { success?: boolean };
        if (!response.ok || result.success !== true) throw new Error('Verzenden mislukt');

        form.reset();
        showStatus(
          '<strong>Bedankt voor uw bericht.</strong><br />We hebben het goed ontvangen en nemen zo snel mogelijk contact met u op.',
          false,
        );
      } catch {
        showStatus(
          `Het verzenden is helaas niet gelukt. Probeer het later opnieuw, of mail direct naar <a class="text-link" href="mailto:${fallbackEmail}">${fallbackEmail}</a>.`,
          true,
        );
      } finally {
        setLoading(false);
      }
    });
  }
</script>
