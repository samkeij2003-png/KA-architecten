---
import { items, text } from '../../lib/mijn-sasa/client';
import { sasaField, sasaSection } from '../../lib/site-content';
import type { SectionProps } from './types';

type Props = SectionProps;
const { section } = Astro.props;
const d = section.data;
---

<section class="section hairline" {...sasaSection(section.id)}>
  <div class="container split-2">
    <div><p class="eyebrow" {...sasaField(section.id, 'eyebrow')}>{text(d.eyebrow)}</p></div>
    <div class="usp-row" style="border-top: 0; padding-top: 0;">
      {items(d.items).map((item) => (
        <div class="usp">
          <h3 {...sasaField(section.id, `items.${item.id}.title`)}>{text(item.title)}</h3>
          <p {...sasaField(section.id, `items.${item.id}.text`)}>{text(item.text)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
