---
/** Hoofdmenu uit Mijn SASA (Menu's → Hoofdmenu). Het logo ligt vast in het ontwerp. */
import type { Cms } from '../lib/mijn-sasa/client';
import { route } from '../lib/site-content';

interface Props {
  cms: Cms;
}

const { cms } = Astro.props;
const navLinks = cms
  .menu('main')
  .items.map((item) => ({ href: cms.href(item), label: item.label }))
  .filter((l): l is { href: string; label: string } => !!l.href && !!l.label);

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav class="nav" aria-label="Hoofdmenu">
    <a class="logo" href={route('/')} aria-label="KA.architecten — home">
      <span class="amark">KA</span><span class="dot">.</span>architecten
    </a>
    <button class="nav-toggle" aria-label="Menu openen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links" role="menu">
      {navLinks.map(({ href, label }) => (
        <a
          href={route(href)}
          class:list={[{ 'is-active': href.startsWith('/') && href !== '/' && currentPath.startsWith(route(href)) }]}
        >
          {label}
        </a>
      ))}
    </div>
  </nav>
</header>
